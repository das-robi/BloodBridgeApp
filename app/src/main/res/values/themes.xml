<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.BloodBridge" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.BloodBridge" parent="Base.Theme.BloodBridge" />

    <style name="CircleImage" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Global Button Styles -->
    <style name="AppButton.White" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/selector_white_to_red_text</item>
        <item name="backgroundTint">@color/selector_white_to_red_bg</item>
        <item name="strokeColor">@color/selector_white_to_red_stroke</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:stateListAnimator">@animator/btn_hover_elevation</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="AppButton.Red" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/selector_red_to_white_text</item>
        <item name="backgroundTint">@color/selector_red_to_white_bg</item>
        <item name="strokeColor">@color/selector_red_to_white_stroke</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:stateListAnimator">@animator/btn_hover_elevation</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
