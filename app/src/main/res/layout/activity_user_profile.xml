<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Views.UserProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textSize="18sp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDonorProfile"
            style="@style/AppButton.Red"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="Donor Profile" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateBloodRequest"
            style="@style/AppButton.Red"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:text="Create Blood Request" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewAllRequests"
            style="@style/AppButton.Red"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:text="View All Requests" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFindDonors"
            style="@style/AppButton.Red"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:text="Find Donors" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifications"
            style="@style/AppButton.Red"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:text="Notifications" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminDashboard"
            style="@style/AppButton.Red"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="Admin Dashboard"
            android:visibility="gone"
            app:backgroundTint="#FF9800" />

    </LinearLayout>

</LinearLayout>