<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnBackUpdate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back_black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Edit Donor Profile"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Blood Group (READ ONLY - NON EDITABLE) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="BLOOD GROUP (LOCKED)"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUpdateBloodGroup"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_input_field"
            android:clickable="false"
            android:enabled="false"
            android:focusable="false"
            android:hint="A+"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#6B7280"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="* Blood group cannot be modified after registration."
            android:textColor="#E53935"
            android:textSize="11sp" />

        <!-- City -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="CITY"
            android:textColor="#374151"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUpdateCity"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. Dhaka"
            android:inputType="textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#111827"
            android:textSize="15sp" />

        <!-- District -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="DISTRICT"
            android:textColor="#374151"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUpdateDistrict"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. Dhaka"
            android:inputType="textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#111827"
            android:textSize="15sp" />

        <!-- Phone Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="PHONE NUMBER"
            android:textColor="#374151"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUpdatePhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. +880 1712 345678"
            android:inputType="phone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#111827"
            android:textSize="15sp" />

        <!-- Last Donation Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="LAST DONATION DATE"
            android:textColor="#374151"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUpdateLastDonateDate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_field"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_calendar"
            android:focusable="false"
            android:hint="YYYY-MM-DD"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#111827"
            android:textSize="15sp" />

        <!-- Availability Checkbox -->
        <CheckBox
            android:id="@+id/cbUpdateAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="Available for Blood Donation"
            android:textColor="#111827"
            android:textSize="14sp" />

        <!-- Submit Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUpdateDonor"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_red_button"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>